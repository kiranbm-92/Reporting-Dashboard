                    frtSec: frtVal,
                    furtMin: furtVal,
                    csatResolved: isResolvedSatisfaction,
                    csatUnderstood: understoodIssue,
                    surveyCount: 1
                });
            }

            rawDataset = records;
        }

        /**
         * Handle user uploaded Excel file (25082026.xlsx)
         */
        function handleExcelUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    
                    let parsedRecords = [];

                    // Try parsing primary sheets or fallback to first sheet
                    const sheetNames = workbook.SheetNames;
                    const primarySheet = workbook.Sheets['Volume Trend'] || workbook.Sheets[sheetNames[0]];
                    const jsonRows = XLSX.utils.sheet_to_json(primarySheet);

                    jsonRows.forEach((row, idx) => {
                        parsedRecords.push({
                            caseId: row['Case Number'] || row['Case Id'] || `CAS-XLS-${idx}`,
                            creationTime: row['Case Creation Time'] ? new Date(row['Case Creation Time']) : new Date(),
                            agency: row['Agency'] || row['Case First Assignee Agency'] || 'Concentrix',
                            liveChatMenu: row['LiveChat Menu'] || row['WF_Query Type'] || 'General Query',
                            liveChatSubMenu: row['LiveChat Sub Menu'] || 'General',
                            vipUser: row['VIP User'] || 'No',
                            agentName: row['Case Handled By'] || row['Agent'] || 'Agent ' + (idx % 10),
                            caseCount: parseFloat(row['Case Count']) || 1,
                            noOfTicketsCreated: parseFloat(row['No of ticket created']) || 0,
                            frtSec: parseFloat(row['CX FRT w/o Bot Time - V1']) || Math.floor(50 + Math.random() * 50),
                            furtMin: parseFloat(row['Total Assignment Duration']) || parseFloat((12 + Math.random() * 8).toFixed(1)),
                            csatResolved: row['Was your issue resolved to your satisfaction?'] === 'Yes' ? 'Yes' : 'No',
                            csatUnderstood: 'Yes',
                            surveyCount: 1
                        });
                    });

                    if (parsedRecords.length > 0) {
                        rawDataset = parsedRecords;
                        document.getElementById('data-status-badge').innerHTML = 
                            `<i class="fa-solid fa-circle text-[8px] mr-1 animate-pulse"></i> Loaded Custom Excel (${parsedRecords.length} rows)`;
                        populateFilterDropdowns();
                        applyFilters();
                    }
                } catch (err) {
                    alert('Error parsing uploaded Excel file. Reverting to default workbook structure.');
                    console.error(err);
                }
            };
            reader.readAsArrayBuffer(file);
        }

