<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CX & Operations Performance Dashboard</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SheetJS (xlsx reader) -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body { background-color: #0f172a; color: #f8fafc; font-family: ui-sans-serif, system-ui, sans-serif; }
  </style>
</head>
<body class="p-6">

  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 border-b border-slate-700 pb-4">
    <div>
      <h1 class="text-2xl font-bold text-sky-400">CX & Operations Performance Dashboard</h1>
      <p class="text-slate-400 text-sm">Real-time daily, weekly, and monthly CX operational metrics</p>
    </div>
    
    <!-- Controls -->
    <div class="flex flex-wrap items-center gap-3">
      <!-- File Upload -->
      <label class="bg-sky-600 hover:bg-sky-500 text-white font-medium px-4 py-2 rounded-lg cursor-pointer text-sm transition">
        📁 Upload Excel / CSV
        <input type="file" id="fileInput" accept=".xlsx, .xls, .csv" class="hidden" multiple>
      </label>

      <!-- Time View Slicer -->
      <div class="bg-slate-800 p-1 rounded-lg flex border border-slate-700 text-sm">
        <button id="btnDaily" onclick="setGranularity('daily')" class="px-3 py-1 rounded-md text-slate-300 font-medium">Daily</button>
        <button id="btnWeekly" onclick="setGranularity('weekly')" class="px-3 py-1 rounded-md text-slate-300 font-medium">Weekly</button>
        <button id="btnMonthly" onclick="setGranularity('monthly')" class="px-3 py-1 rounded-md text-slate-300 font-medium">Monthly</button>
      </div>

      <!-- Manage Stored Data Modal Toggle -->
      <button onclick="toggleDataModal()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-2 rounded-lg text-sm transition">
        ⚙️ Manage Stored Data
      </button>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-md">
      <div class="text-xs font-semibold text-slate-400 uppercase">Total Handled Volume</div>
      <div id="kpiVolume" class="text-2xl font-bold text-sky-400 mt-2">0</div>
      <div class="text-xs text-slate-500 mt-1">Total Handled Cases</div>
    </div>

    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-md">
      <div class="text-xs font-semibold text-slate-400 uppercase">Ticket Creation %</div>
      <div id="kpiTicketPct" class="text-2xl font-bold text-white mt-2">0.0%</div>
      <div class="text-xs text-slate-400 mt-1">Target: <span class="text-emerald-400 font-medium">&lt; 10%</span></div>
    </div>

    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-md">
      <div class="text-xs font-semibold text-slate-400 uppercase">Avg FRT</div>
      <div id="kpiFRT" class="text-2xl font-bold text-white mt-2">0s</div>
      <div class="text-xs text-slate-400 mt-1">Target: <span class="text-emerald-400 font-medium">&lt; 90s</span></div>
    </div>

    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-md">
      <div class="text-xs font-semibold text-slate-400 uppercase">Avg FuRT</div>
      <div id="kpiFuRT" class="text-2xl font-bold text-white mt-2">0.0m</div>
      <div class="text-xs text-slate-400 mt-1">Target: <span class="text-emerald-400 font-medium">&lt; 17.5m</span></div>
    </div>

    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-md">
      <div class="text-xs font-semibold text-slate-400 uppercase">CSAT Score</div>
      <div id="kpiCSAT" class="text-2xl font-bold text-white mt-2">0.0%</div>
      <div class="text-xs text-slate-400 mt-1">Target: <span class="text-emerald-400 font-medium">&gt; 85%</span></div>
    </div>
  </div>

  <!-- Dashboard Charts Row 1 -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700">
      <h3 class="text-md font-semibold text-slate-200 mb-3">Volume Trend & Ticket Creation %</h3>
      <div class="h-64"><canvas id="volumeChart"></canvas></div>
    </div>

    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700">
      <h3 class="text-md font-semibold text-slate-200 mb-3">Response SLA Trends (FRT vs FuRT)</h3>
      <div class="h-64"><canvas id="slaChart"></canvas></div>
    </div>
  </div>

  <!-- Dashboard Charts Row 2 -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700">
      <h3 class="text-md font-semibold text-slate-200 mb-3">CSAT Resolution Breakdown</h3>
      <div class="h-64 flex justify-center"><canvas id="csatChart"></canvas></div>
    </div>

    <div class="lg:col-span-2 bg-slate-800 p-4 rounded-xl border border-slate-700">
      <h3 class="text-md font-semibold text-slate-200 mb-3">Volume by Issue Category</h3>
      <div class="h-64"><canvas id="categoryChart"></canvas></div>
    </div>
  </div>

  <!-- Data Management Modal -->
  <div id="dataModal" class="fixed inset-0 bg-black/70 hidden flex justify-center items-center p-4 z-50">
    <div class="bg-slate-800 border border-slate-700 rounded-xl max-w-xl w-full p-6 shadow-xl">
      <div class="flex justify-between items-center mb-4 border-b border-slate-700 pb-2">
        <h3 class="text-lg font-bold text-sky-400">Stored Days Data Manager</h3>
        <button onclick="toggleDataModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <div class="max-h-60 overflow-y-auto mb-4">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900 text-slate-400 uppercase text-xs sticky top-0">
            <tr>
              <th class="p-2">Date</th>
              <th class="p-2">Records Count</th>
              <th class="p-2 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="daysTableBody" class="divide-y divide-slate-700">
            <!-- Dynamic Date Rows -->
          </tbody>
        </table>
      </div>

      <div class="flex justify-between items-center pt-2">
        <button onclick="clearAllData()" class="bg-red-600/80 hover:bg-red-600 text-white text-xs px-3 py-2 rounded transition">
          ⚠️ Delete All Stored Data
        </button>
        <button onclick="toggleDataModal()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs px-4 py-2 rounded transition">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- JavaScript Application Logic -->
  <script>
    // --- IndexedDB Local Database Setup ---
    let db;
    const dbReq = indexedDB.open("CX_Dashboard_DB", 1);

    dbReq.onupgradeneeded = (e) => {
      db = e.target.result;
      if (!db.objectStoreNames.contains("records")) {
        const store = db.createObjectStore("records", { keyPath: "id", autoIncrement: true });
        store.createIndex("date", "date", { unique: false });
      }
    };

    dbReq.onsuccess = (e) => {
      db = e.target.result;
      refreshDashboard();
    };

    let currentGranularity = 'daily';

    function setGranularity(type) {
      currentGranularity = type;
      ['btnDaily', 'btnWeekly', 'btnMonthly'].forEach(id => {
        document.getElementById(id).classList.remove('bg-sky-600', 'text-white');
        document.getElementById(id).classList.add('text-slate-300');
      });
      const activeBtn = type === 'daily' ? 'btnDaily' : type === 'weekly' ? 'btnWeekly' : 'btnMonthly';
      document.getElementById(activeBtn).classList.add('bg-sky-600', 'text-white');
      refreshDashboard();
    }

    // --- File Upload & Parser ---
    document.getElementById('fileInput').addEventListener('change', handleFileUpload);

    async function handleFileUpload(e) {
      const files = e.target.files;
      if (!files.length) return;

      for (let file of files) {
        const buffer = await file.arrayBuffer();
        const workbook = XLSX.read(buffer, { type: 'array' });

        const records = [];
        workbook.SheetNames.forEach(sheetName => {
          const rawData = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName], { header: 1 });
          if (rawData.length < 3) return;

          // Headers are typically at row index 2 in provided structure
          const headers = rawData[2] || rawData[1] || rawData[0];
          
          for (let i = 3; i < rawData.length; i++) {
            const row = rawData[i];
            if (!row || row.length === 0) continue;

            const record = {};
            headers.forEach((h, idx) => { if (h) record[h.trim()] = row[idx]; });

            // Extract date
            const dateStr = record['Case Creation Time'] || record['Survey Response Date'] || record['Case Assigned Time (Case) (DateTime)'];
            if (dateStr) {
              const parsedDate = new Date(dateStr);
              if (!isNaN(parsedDate.getTime())) {
                record.date = parsedDate.toISOString().split('T')[0];
                record.sheet = sheetName;
                records.push(record);
              }
            }
          }
        });

        if (records.length > 0) {
          await saveRecordsToDB(records);
        }
      }
      refreshDashboard();
      alert('File processed and stored successfully!');
    }

    // --- Database Helper Functions ---
    function saveRecordsToDB(records) {
      return new Promise((resolve) => {
        const tx = db.transaction("records", "readwrite");
        const store = tx.objectStore("records");
        records.forEach(r => store.add(r));
        tx.oncomplete = () => resolve();
      });
    }

    function getAllRecords() {
      return new Promise((resolve) => {
        if (!db) return resolve([]);
        const tx = db.transaction("records", "readonly");
        const store = tx.objectStore("records");
        const req = store.getAll();
        req.onsuccess = () => resolve(req.result);
      });
    }

    async function deleteDateData(dateStr) {
      if (!confirm(`Are you sure you want to delete all data for ${dateStr}?`)) return;
      const tx = db.transaction("records", "readwrite");
      const store = tx.objectStore("records");
      const index = store.index("date");
      const req = index.openCursor(IDBKeyRange.only(dateStr));
      
      req.onsuccess = (e) => {
        const cursor = e.target.result;
        if (cursor) {
          store.delete(cursor.primaryKey);
          cursor.continue();
        }
      };
      
      tx.oncomplete = () => {
        populateDataModal();
        refreshDashboard();
      };
    }

    async function clearAllData() {
      if (!confirm("Are you sure you want to delete ALL stored database records?")) return;
      const tx = db.transaction("records", "readwrite");
      tx.objectStore("records").clear();
      tx.oncomplete = () => {
        populateDataModal();
        refreshDashboard();
      };
    }

    // --- Dashboard Aggregation & Render Engine ---
    let charts = {};

    async function refreshDashboard() {
      const records = await getAllRecords();

      let totalVolume = 0;
      let totalTickets = 0;
      let frtSum = 0, frtCount = 0;
      let furtSum = 0, furtCount = 0;
      let csatYes = 0, csatTotal = 0;

      const groupedData = {};
      const categoryData = {};

      records.forEach(r => {
        let groupKey = r.date;
        if (currentGranularity === 'monthly' && r.date) groupKey = r.date.substring(0, 7);
        
        if (r.date && !groupedData[groupKey]) {
          groupedData[groupKey] = { volume: 0, tickets: 0, frtSum: 0, frtCnt: 0, furtSum: 0, furtCnt: 0 };
        }

        // 1. Volume & Tickets
        const count = parseFloat(r['Case Count (SUM)']) || 0;
        const tickets = parseFloat(r['No of ticket created (SUM)']) || 0;
        if (count) {
          totalVolume += count;
          totalTickets += tickets;
          if (groupedData[groupKey]) {
            groupedData[groupKey].volume += count;
            groupedData[groupKey].tickets += tickets;
          }
        }

        // Category Aggregation
        const menu = r['LiveChat Menu (Case)'] || r['WF_Query Type (Case)'];
        if (menu && count) {
          categoryData[menu] = (categoryData[menu] || 0) + count;
        }

        // 2. FRT Parse
        if (r['CX FRT w/o Bot Time - V1 (SUM)'] || r['CX FRT w/o Bot Time - V1 (AVG)']) {
          const frtVal = parseTimeToSeconds(r['CX FRT w/o Bot Time - V1 (SUM)'] || r['CX FRT w/o Bot Time - V1 (AVG)']);
          if (frtVal > 0) {
            frtSum += frtVal; frtCount++;
            if (groupedData[groupKey]) { groupedData[groupKey].frtSum += frtVal; groupedData[groupKey].frtCnt++; }
          }
        }

        // 3. FuRT Parse
        if (r['CX FuRT w/o Bot Time - LiveChat (SUM)'] || r['Total Assignment Duration (AVG)']) {
          const furtVal = parseTimeToSeconds(r['CX FuRT w/o Bot Time - LiveChat (SUM)'] || r['Total Assignment Duration (AVG)']);
          if (furtVal > 0) {
            furtSum += furtVal; furtCount++;
            if (groupedData[groupKey]) { groupedData[groupKey].furtSum += furtVal; groupedData[groupKey].furtCnt++; }
          }
        }

        // 4. CSAT
        const satisfaction = r['Was your issue resolved to your satisfaction?'] || r['Was the representative able to understand the issue and take needful actions?'];
        if (satisfaction) {
          csatTotal++;
          if (String(satisfaction).toLowerCase().includes('yes')) csatYes++;
        }
      });

      // Update KPI UI
      const ticketPct = totalVolume ? ((totalTickets / totalVolume) * 100).toFixed(1) : "0.0";
      const avgFRT = frtCount ? (frtSum / frtCount).toFixed(0) : "0";
      const avgFuRT = furtCount ? ((furtSum / furtCount) / 60).toFixed(1) : "0.0";
      const csatPct = csatTotal ? ((csatYes / csatTotal) * 100).toFixed(1) : "0.0";

      document.getElementById('kpiVolume').innerText = totalVolume.toLocaleString();
      document.getElementById('kpiTicketPct').innerText = `${ticketPct}%`;
      document.getElementById('kpiFRT').innerText = `${avgFRT}s`;
      document.getElementById('kpiFuRT').innerText = `${avgFuRT}m`;
      document.getElementById('kpiCSAT').innerText = `${csatPct}%`;

      // KPI Target Colors
      document.getElementById('kpiTicketPct').className = `text-2xl font-bold mt-2 ${parseFloat(ticketPct) <= 10 ? 'text-emerald-400' : 'text-rose-400'}`;
      document.getElementById('kpiFRT').className = `text-2xl font-bold mt-2 ${parseFloat(avgFRT) <= 90 ? 'text-emerald-400' : 'text-rose-400'}`;
      document.getElementById('kpiFuRT').className = `text-2xl font-bold mt-2 ${parseFloat(avgFuRT) <= 17.5 ? 'text-emerald-400' : 'text-rose-400'}`;
      document.getElementById('kpiCSAT').className = `text-2xl font-bold mt-2 ${parseFloat(csatPct) >= 85 ? 'text-emerald-400' : 'text-rose-400'}`;

      // Render Charts
      renderCharts(groupedData, categoryData, csatYes, csatTotal - csatYes);
    }

    function renderCharts(groupedData, categoryData, csatYes, csatNo) {
      const labels = Object.keys(groupedData).sort();
      const volumes = labels.map(l => groupedData[l].volume);
      const ticketPcts = labels.map(l => groupedData[l].volume ? ((groupedData[l].tickets / groupedData[l].volume) * 100).toFixed(1) : 0);
      const frts = labels.map(l => groupedData[l].frtCnt ? (groupedData[l].frtSum / groupedData[l].frtCnt).toFixed(0) : 0);
      const furts = labels.map(l => groupedData[l].furtCnt ? ((groupedData[l].furtSum / groupedData[l].furtCnt) / 60).toFixed(1) : 0);

      // Volume & Ticket Chart
      if (charts.volume) charts.volume.destroy();
      charts.volume = new Chart(document.getElementById('volumeChart'), {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            { label: 'Handled Volume', data: volumes, backgroundColor: '#0ea5e9', yAxisID: 'y' },
            { label: 'Ticket Creation %', data: ticketPcts, type: 'line', borderColor: '#f59e0b', yAxisID: 'y1' }
          ]
        },
        options: { responsive: true, maintainAspectRatio: false, scales: { y: { position: 'left' }, y1: { position: 'right', grid: { drawOnChartArea: false } } } }
      });

      // SLA Chart
      if (charts.sla) charts.sla.destroy();
      charts.sla = new Chart(document.getElementById('slaChart'), {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            { label: 'Avg FRT (sec)', data: frts, borderColor: '#38bdf8', fill: false },
            { label: 'Avg FuRT (min)', data: furts, borderColor: '#a855f7', fill: false }
          ]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      // CSAT Donut Chart
      if (charts.csat) charts.csat.destroy();
      charts.csat = new Chart(document.getElementById('csatChart'), {
        type: 'doughnut',
        data: {
          labels: ['Satisfied (Yes)', 'Dissatisfied (No)'],
          datasets: [{ data: [csatYes, csatNo], backgroundColor: ['#10b981', '#ef4444'] }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      // Category Chart
      if (charts.category) charts.category.destroy();
      const catLabels = Object.keys(categoryData).slice(0, 7);
      charts.category = new Chart(document.getElementById('categoryChart'), {
        type: 'bar',
        data: {
          labels: catLabels,
          datasets: [{ label: 'Volume', data: catLabels.map(c => categoryData[c]), backgroundColor: '#6366f1' }]
        },
        options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y' }
      });
    }

    // Modal & Stored Data Manager
    async function toggleDataModal() {
      const modal = document.getElementById('dataModal');
      modal.classList.toggle('hidden');
      if (!modal.classList.contains('hidden')) {
        await populateDataModal();
      }
    }

    async function populateDataModal() {
      const records = await getAllRecords();
      const dateCounts = {};
      records.forEach(r => { if (r.date) dateCounts[r.date] = (dateCounts[r.date] || 0) + 1; });

      const tbody = document.getElementById('daysTableBody');
      tbody.innerHTML = '';

      Object.keys(dateCounts).sort().reverse().forEach(date => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="p-2">${date}</td>
          <td class="p-2">${dateCounts[date]} records</td>
          <td class="p-2 text-right">
            <button onclick="deleteDateData('${date}')" class="text-rose-400 hover:text-rose-300 font-medium">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Utility: Parse time HH:MM:SS to seconds
    function parseTimeToSeconds(timeStr) {
      if (!timeStr) return 0;
      if (typeof timeStr === 'number') return timeStr;
      const parts = String(timeStr).split(':');
      if (parts.length === 3) {
        return (+parts[0]) * 3600 + (+parts[1]) * 60 + (+parseFloat(parts[2]));
      }
      return 0;
    }
  </script>
</body>
</html>
