                // FuRT in minutes (target < 17.5m)
                let furtVal = parseFloat((10 + Math.random() * 12).toFixed(1));
                if (menuObj.menu === 'VIP Escalation') furtVal = parseFloat((8 + Math.random() * 6).toFixed(1));

                // CSAT
                const isResolvedSatisfaction = Math.random() < (isVip === 'Yes' ? 0.92 : 0.86) ? 'Yes' : 'No';
                const understoodIssue = Math.random() < 0.88 ? 'Yes' : 'No';

                records.push({
                    caseId: `CAS-2026-${10000 + i}`,
                    creationTime: caseDate,
                    agency: agentObj.agency,
                    liveChatMenu: menuObj.menu,
                    liveChatSubMenu: menuObj.sub,
                    vipUser: isVip,
                    agentName: agentObj.name,
                    caseCount: caseCount,
