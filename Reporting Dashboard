        /**
         * DAX Calculation Logic for KPI Cards
         */
        function updateKPICards() {
            const totalCases = filteredDataset.reduce((sum, d) => sum + d.caseCount, 0);
            const totalTickets = filteredDataset.reduce((sum, d) => sum + d.noOfTicketsCreated, 0);
            const ticketPercent = totalCases > 0 ? (totalTickets / totalCases) * 100 : 0;

            const avgFrt = totalCases > 0 ? (filteredDataset.reduce((sum, d) => sum + d.frtSec, 0) / totalCases) : 0;
            const avgFurt = totalCases > 0 ? (filteredDataset.reduce((sum, d) => sum + d.furtMin, 0) / totalCases) : 0;

            const csatYesCount = filteredDataset.filter(d => d.csatResolved === 'Yes').length;
            const csatTotalSurveys = filteredDataset.length;
            const csatPercent = csatTotalSurveys > 0 ? (csatYesCount / csatTotalSurveys) * 100 : 0;

            // 1. Total Volume
            document.getElementById('kpi-volume-val').innerText = totalCases.toLocaleString();
            document.getElementById('kpi-volume-diff').innerHTML = `<i class="fa-solid fa-arrow-trend-up"></i> +${(Math.random() * 4 + 1).toFixed(1)}%`;

            // 2. Ticket Creation %
            document.getElementById('kpi-ticket-val').innerText = ticketPercent.toFixed(1) + '%';
            document.getElementById('kpi-ticket-created-count').innerText = `${totalTickets} Tickets`;
            const ticketBadge = document.getElementById('kpi-ticket-badge');
            const ticketIcon = document.getElementById('kpi-ticket-status-icon');
            if (ticketPercent <= BENCHMARKS.ticketCreation) {
                ticketBadge.className = 'px-2 py-0.5 rounded-full font-semibold text-[10px] metric-badge-green';
                ticketBadge.innerText = 'Target Met (≤10%)';
                ticketIcon.className = 'p-1.5 rounded-lg text-xs bg-emerald-500/10 text-emerald-400';
            } else {
                ticketBadge.className = 'px-2 py-0.5 rounded-full font-semibold text-[10px] metric-badge-red';
                ticketBadge.innerText = 'Over Target (>10%)';
                ticketIcon.className = 'p-1.5 rounded-lg text-xs bg-rose-500/10 text-rose-400';
            }

            // 3. Avg FRT
            document.getElementById('kpi-frt-val').innerText = `${Math.round(avgFrt)}s`;
            const frtSlaMet = filteredDataset.filter(d => d.frtSec <= BENCHMARKS.frt).length;
            const frtSlaPct = totalCases > 0 ? ((frtSlaMet / totalCases) * 100).toFixed(0) : 0;
            document.getElementById('kpi-frt-sla').innerText = `SLA: ${frtSlaPct}% Compliant`;

            // 4. Avg FuRT
            document.getElementById('kpi-furt-val').innerText = `${avgFurt.toFixed(1)}m`;
            const furtBreached = filteredDataset.filter(d => d.furtMin > BENCHMARKS.furt).length;
            document.getElementById('kpi-furt-breach').innerText = `${furtBreached} Breached SLA`;

            // 5. CSAT
            document.getElementById('kpi-csat-val').innerText = `${csatPercent.toFixed(1)}%`;
            document.getElementById('kpi-csat-count').innerText = `${csatTotalSurveys} Responses`;
        }

        /**
         * Group Data by Dynamic Time Bucket
         */
        function getGroupedByTime() {
            const timeMap = {};

            filteredDataset.forEach(item => {
                const dateObj = new Date(item.creationTime);
                let timeKey = '';

                if (currentGranularity === 'daily') {
                    timeKey = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                } else if (currentGranularity === 'weekly') {
                    // Week Number calculation
                    const firstDayOfYear = new Date(dateObj.getFullYear(), 0, 1);
                    const pastDaysOfYear = (dateObj - firstDayOfYear) / 86400000;
                    const weekNum = Math.ceil((pastDaysOfYear + firstDayOfYear.getDay() + 1) / 7);
                    timeKey = `Wk ${weekNum}`;
                } else {
                    timeKey = dateObj.toLocaleDateString('en-US', { month: 'short', year: '2026' });
                }

                if (!timeMap[timeKey]) {
                    timeMap[timeKey] = {
                        key: timeKey,
                        volume: 0,
                        tickets: 0,
                        frtSum: 0,
                        furtSum: 0,
                        csatYes: 0,
                        totalSurveys: 0,
                        dateRaw: dateObj
                    };
                }

                timeMap[timeKey].volume += item.caseCount;
                timeMap[timeKey].tickets += item.noOfTicketsCreated;
                timeMap[timeKey].frtSum += item.frtSec;
                timeMap[timeKey].furtSum += item.furtMin;
                if (item.csatResolved === 'Yes') timeMap[timeKey].csatYes += 1;
                timeMap[timeKey].totalSurveys += 1;
            });

            // Return sorted chronologically
            return Object.values(timeMap).sort((a, b) => a.dateRaw - b.dateRaw);
        }

