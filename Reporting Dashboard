<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive CX & Operations Performance Dashboard</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js for Visualizations (Fixed CDN) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.min.js"></script>
    <!-- SheetJS for processing Excel files (Fixed CDN) -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        navy: {
                            800: '#1E293B',
                            900: '#0F172A',
                            950: '#0B0F19'
                        },
                        tealBrand: '#0EA5E9',
                        amberBrand: '#F59E0B',
                        emeraldBrand: '#10B981',
                        roseBrand: '#EF4444'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Styling for BI Aesthetics */
        body {
            background-color: #0F172A;
            color: #F8FAFC;
            font-family: 'Inter', sans-serif;
        }

        /* Glassmorphism Cards */
        .bi-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            transition: all 0.25s ease-in-out;
        }
        .bi-card:hover {
            border-color: rgba(14, 165, 233, 0.3);
            box-shadow: 0 12px 30px -5px rgba(14, 165, 233, 0.15);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0F172A;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0EA5E9;
        }

        /* Active Filter Pill */
        .pill-active {
            background: linear-gradient(135deg, #0EA5E9 0%, #0284C7 100%);
            color: #FFFFFF;
            box-shadow: 0 4px 12px rgba(14, 165, 233, 0.4);
        }

        .pill-inactive {
            background: #1E293B;
            color: #94A3B8;
            border: 1px solid #334155;
        }
        .pill-inactive:hover {
            background: #334155;
            color: #F8FAFC;
        }

        /* Data Heatmap Table Cell Styling */
        .metric-badge-green { background-color: rgba(16, 185, 129, 0.15); color: #10B981; border: 1px solid rgba(16, 185, 129, 0.3); }
        .metric-badge-red { background-color: rgba(239, 68, 68, 0.15); color: #EF4444; border: 1px solid rgba(239, 68, 68, 0.3); }
        .metric-badge-amber { background-color: rgba(245, 158, 11, 0.15); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.3); }
    </style>
</head>
<body class="min-h-screen pb-12">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 lg:px-8 py-3 mb-6">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <!-- Title & Metadata -->
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-gradient-to-tr from-sky-500 to-teal-400 rounded-xl shadow-lg shadow-sky-500/20 text-white">
                    <i class="fa-solid fa-chart-line text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                        CX & Operations Performance Dashboard
                        <span id="data-status-badge" class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                            <i class="fa-solid fa-circle text-[8px] mr-1 animate-pulse"></i> Loaded: 25082026.xlsx
                        </span>
                    </h1>
                    <p class="text-xs text-slate-400">Live Executive Insights • FRT & FuRT SLA Benchmarks • CSAT Analysis</p>
                </div>
            </div>

            <!-- Granularity Switcher & Excel Uploader -->
            <div class="flex flex-wrap items-center gap-3">
                <!-- Time Granularity Switcher -->
                <div class="bg-slate-800 p-1 rounded-xl border border-slate-700 flex items-center shadow-inner">
                    <button onclick="setTimeGranularity('daily')" id="btn-gran-daily" class="px-3 py-1.5 text-xs font-semibold rounded-lg pill-active transition-all">
                        <i class="fa-regular fa-calendar-day mr-1"></i> Daily
                    </button>
                    <button onclick="setTimeGranularity('weekly')" id="btn-gran-weekly" class="px-3 py-1.5 text-xs font-semibold rounded-lg pill-inactive transition-all">
                        <i class="fa-solid fa-calendar-week mr-1"></i> Weekly
                    </button>
                    <button onclick="setTimeGranularity('monthly')" id="btn-gran-monthly" class="px-3 py-1.5 text-xs font-semibold rounded-lg pill-inactive transition-all">
                        <i class="fa-regular fa-calendar-days mr-1"></i> Monthly
                    </button>
                </div>

                <!-- Excel Uploader Button -->
                <label class="cursor-pointer px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-sky-400 text-xs font-semibold rounded-xl border border-sky-500/30 transition flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-file-excel"></i>
                    <span>Upload Workbook</span>
                    <input type="file" id="excel-file-input" accept=".xlsx, .xls" class="hidden" onchange="handleExcelUpload(event)">
                </label>

                <!-- Export Report Button -->
                <button onclick="exportDashboardSummary()" class="px-3.5 py-2 bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold rounded-xl transition shadow-md shadow-sky-600/30 flex items-center gap-2">
                    <i class="fa-solid fa-download"></i>
                    <span>Export BI Summary</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dashboard Container -->
    <main class="max-w-7xl mx-auto px-4 lg:px-8 space-y-6">

        <!-- Global Filters Panel -->
        <section class="bi-card rounded-2xl p-4">
            <div class="flex items-center justify-between mb-3 border-b border-slate-800 pb-2">
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400">
                    <i class="fa-solid fa-filter text-sky-400"></i> Global Dashboard Filters
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="resetAllFilters()" class="text-xs text-sky-400 hover:text-sky-300 transition flex items-center gap-1 font-medium">
                        <i class="fa-solid fa-rotate-left"></i> Reset Filters
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3">
                <!-- Agency Filter -->
                <div>
                    <label class="block text-[11px] font-medium text-slate-400 mb-1">Agency</label>
                    <select id="filter-agency" onchange="applyFilters()" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg text-xs p-2 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        <option value="ALL">All Agencies</option>
                    </select>
                </div>

                <!-- LiveChat Menu Filter -->
                <div>
                    <label class="block text-[11px] font-medium text-slate-400 mb-1">LiveChat Menu / Category</label>
                    <select id="filter-menu" onchange="applyFilters()" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg text-xs p-2 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        <option value="ALL">All Categories</option>
                    </select>
                </div>

                <!-- VIP User Filter -->
                <div>
                    <label class="block text-[11px] font-medium text-slate-400 mb-1">VIP User Status</label>
                    <select id="filter-vip" onchange="applyFilters()" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg text-xs p-2 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        <option value="ALL">All Users</option>
                        <option value="Yes">VIP Only</option>
                        <option value="No">Non-VIP</option>
                    </select>
                </div>

                <!-- Agent Name Filter -->
                <div>
                    <label class="block text-[11px] font-medium text-slate-400 mb-1">Agent Name</label>
                    <select id="filter-agent" onchange="applyFilters()" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg text-xs p-2 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        <option value="ALL">All Agents</option>
                    </select>
                </div>

                <!-- Active Filter Indicator Bar -->
                <div class="flex flex-col justify-end">
                    <div id="active-filter-summary" class="bg-slate-900/60 border border-slate-800 rounded-lg p-2 text-[11px] text-slate-400 truncate">
                        <span class="text-sky-400 font-semibold">Active:</span> Showing all data
                    </div>
                </div>
            </div>
        </section>

        <!-- ROW 1: Key Performance Indicator (KPI) Summary Cards -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">

            <!-- KPI 1: Total Handled Volume -->
            <div class="bi-card rounded-2xl p-4 flex flex-col justify-between relative overflow-hidden group">
                <div class="absolute -right-4 -bottom-4 text-sky-500/5 text-7xl font-bold group-hover:text-sky-500/10 transition">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <div>
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">Total Handled Volume</span>
                        <span class="p-1.5 bg-sky-500/10 text-sky-400 rounded-lg text-xs"><i class="fa-solid fa-comments"></i></span>
                    </div>
                    <div id="kpi-volume-val" class="text-2xl font-extrabold text-white mb-1">--</div>
                </div>
                <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-800">
                    <span id="kpi-volume-diff" class="font-medium text-emerald-400 flex items-center gap-1">
                        <i class="fa-solid fa-arrow-trend-up"></i> +0%
                    </span>
                    <span class="text-slate-500">vs prior period</span>
                </div>
            </div>

            <!-- KPI 2: Ticket Creation % -->
            <div class="bi-card rounded-2xl p-4 flex flex-col justify-between relative overflow-hidden group">
                <div class="absolute -right-4 -bottom-4 text-amber-500/5 text-7xl font-bold group-hover:text-amber-500/10 transition">
                    <i class="fa-solid fa-ticket"></i>
                </div>
                <div>
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">Ticket Creation %</span>
                        <span id="kpi-ticket-status-icon" class="p-1.5 rounded-lg text-xs">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </span>
                    </div>
                    <div id="kpi-ticket-val" class="text-2xl font-extrabold text-white mb-1">--%</div>
                </div>
                <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-800">
                    <span id="kpi-ticket-badge" class="px-2 py-0.5 rounded-full font-semibold text-[10px]">
                        Target: &lt;10%
                    </span>
                    <span id="kpi-ticket-created-count" class="text-slate-400 font-medium">0 Tickets</span>
                </div>
            </div>

            <!-- KPI 3: Avg FRT (First Response Time) -->
            <div class="bi-card rounded-2xl p-4 flex flex-col justify-between relative overflow-hidden group">
                <div class="absolute -right-4 -bottom-4 text-amber-500/5 text-7xl font-bold group-hover:text-amber-500/10 transition">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">Avg FRT (First Response)</span>
                        <span class="p-1.5 bg-amber-500/10 text-amber-400 rounded-lg text-xs"><i class="fa-solid fa-stopwatch"></i></span>
                    </div>
                    <div id="kpi-frt-val" class="text-2xl font-extrabold text-amber-400 mb-1">-- sec</div>
                </div>
                <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-800">
                    <span id="kpi-frt-sla" class="font-medium text-emerald-400">SLA: 0%</span>
                    <span class="text-slate-500">Target &lt;90s</span>
                </div>
            </div>

            <!-- KPI 4: Avg FuRT (Full Resolution Time) -->
            <div class="bi-card rounded-2xl p-4 flex flex-col justify-between relative overflow-hidden group">
                <div class="absolute -right-4 -bottom-4 text-purple-500/5 text-7xl font-bold group-hover:text-purple-500/10 transition">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">Avg FuRT / Duration</span>
                        <span class="p-1.5 bg-purple-500/10 text-purple-400 rounded-lg text-xs"><i class="fa-solid fa-hourglass-half"></i></span>
                    </div>
                    <div id="kpi-furt-val" class="text-2xl font-extrabold text-purple-400 mb-1">-- min</div>
                </div>
                <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-800">
                    <span id="kpi-furt-breach" class="text-rose-400 font-medium">0 Breached</span>
                    <span class="text-slate-500">Target &lt;17.5m</span>
                </div>
            </div>

            <!-- KPI 5: CSAT Score -->
            <div class="bi-card rounded-2xl p-4 flex flex-col justify-between relative overflow-hidden group">
                <div class="absolute -right-4 -bottom-4 text-emerald-500/5 text-7xl font-bold group-hover:text-emerald-500/10 transition">
                    <i class="fa-solid fa-face-smile"></i>
                </div>
                <div>
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">CSAT Score</span>
                        <span class="p-1.5 bg-emerald-500/10 text-emerald-400 rounded-lg text-xs"><i class="fa-solid fa-thumbs-up"></i></span>
                    </div>
                    <div id="kpi-csat-val" class="text-2xl font-extrabold text-emerald-400 mb-1">--%</div>
                </div>
                <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-800">
                    <span id="kpi-csat-count" class="text-slate-300 font-medium">0 Surveys</span>
                    <span class="text-slate-500">Target &gt;85%</span>
                </div>
            </div>

        </section>

        <!-- ROW 2: Volume & Ticket Trends (Time Series Analysis) -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Visual 1: Volume & Ticket Creation % Combo Trend Chart -->
            <div class="bi-card rounded-2xl p-5 lg:col-span-2 flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-chart-column text-sky-400"></i> Total Handled Volume vs Ticket Creation %
                        </h3>
                        <p class="text-xs text-slate-400">Time-series distribution across selected granularity</p>
                    </div>
                    <span class="text-[11px] px-2.5 py-1 rounded-lg bg-slate-800 border border-slate-700 text-sky-400">
                        Target &lt; 10%
                    </span>
                </div>
                <div class="relative flex-1 min-h-[300px]">
                    <canvas id="chart-volume-trend"></canvas>
                </div>
            </div>

            <!-- Visual 2: Breakdown by LiveChat Menu / Category -->
            <div class="bi-card rounded-2xl p-5 flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-layer-group text-teal-400"></i> Volume by Issue Menu
                        </h3>
                        <p class="text-xs text-slate-400">Handled Cases vs Created Tickets</p>
                    </div>
                </div>
                <div class="relative flex-1 min-h-[300px]">
                    <canvas id="chart-menu-breakdown"></canvas>
                </div>
            </div>

        </section>

        <!-- ROW 3: Response & Resolution Time Analysis (FRT & FuRT) -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Visual 3: Dual-Axis Line Chart (Avg FRT vs Avg FuRT) -->
            <div class="bi-card rounded-2xl p-5 flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-clock text-amber-400"></i> FRT vs FuRT Trend
                        </h3>
                        <p class="text-xs text-slate-400">First Response (sec) vs Full Resolution (min)</p>
                    </div>
                </div>
                <div class="relative flex-1 min-h-[300px]">
                    <canvas id="chart-frt-furt-trend"></canvas>
                </div>
            </div>

            <!-- Visual 4: Agent & Agency Performance Matrix -->
            <div class="bi-card rounded-2xl p-5 lg:col-span-2 flex flex-col">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-users-gear text-sky-400"></i> Agent & Agency Performance Matrix
                        </h3>
                        <p class="text-xs text-slate-400">Heatmap operational breakdown with SLA compliance</p>
                    </div>
                    <!-- Search Agent Box -->
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-500 text-xs"></i>
                        <input type="text" id="table-search" onkeyup="renderAgentTable()" placeholder="Search agent or agency..." 
                               class="bg-slate-800 text-slate-200 border border-slate-700 rounded-lg text-xs pl-8 pr-3 py-1.5 focus:ring-1 focus:ring-sky-500 focus:outline-none w-48">
                    </div>
                </div>

                <!-- Matrix Table -->
                <div class="overflow-x-auto flex-1 max-h-[310px] rounded-xl border border-slate-800">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-900/80 text-slate-400 uppercase text-[10px] tracking-wider sticky top-0 border-b border-slate-800">
                            <tr>
                                <th class="p-3">Agent Name</th>
                                <th class="p-3">Agency</th>
                                <th class="p-3 text-right">Cases</th>
                                <th class="p-3 text-right">Avg FRT (s)</th>
                                <th class="p-3 text-right">Avg FuRT (m)</th>
                                <th class="p-3 text-right">CSAT %</th>
                                <th class="p-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody id="agent-matrix-body" class="divide-y divide-slate-800/60">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>

        </section>

        <!-- ROW 4: CSAT & Quality Insights -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Visual 5: CSAT Response Breakdown (Donut) -->
            <div class="bi-card rounded-2xl p-5 flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-chart-pie text-emerald-400"></i> CSAT Resolution Split
                        </h3>
                        <p class="text-xs text-slate-400">Resolved to Customer Satisfaction?</p>
                    </div>
                </div>
                <div class="relative flex-1 min-h-[260px] flex items-center justify-center">
                    <canvas id="chart-csat-donut"></canvas>
                </div>
            </div>

            <!-- Visual 6: CSAT % Aggregated by Agency & Category -->
            <div class="bi-card rounded-2xl p-5 lg:col-span-2 flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-building-user text-purple-400"></i> CSAT Score % by Agency & Category
                        </h3>
                        <p class="text-xs text-slate-400">Customer Satisfaction Index comparison (Target: &gt;85%)</p>
                    </div>
                </div>
                <div class="relative flex-1 min-h-[260px]">
                    <canvas id="chart-csat-agency"></canvas>
                </div>
            </div>

        </section>

    </main>

    <script>
        /**
         * GLOBAL DATA MODEL & DASHBOARD STATE
         */
        let rawDataset = [];
        let filteredDataset = [];
        let currentGranularity = 'daily'; // 'daily' | 'weekly' | 'monthly'

        // Active Global Filter Values
        let activeFilters = {
            agency: 'ALL',
            menu: 'ALL',
            vip: 'ALL',
            agent: 'ALL'
        };

        // Chart Instance References for dynamic destroyed/rebuilt updates
        let chartInstances = {};

        // Benchmark Targets
        const BENCHMARKS = {
            ticketCreation: 10.0, // < 10%
            frt: 90,             // < 90 seconds
            furt: 17.5,           // < 17.5 mins
            csat: 85.0           // > 85%
        };

        /**
         * INITIALIZATION ON PAGE LOAD
         */
        window.addEventListener('DOMContentLoaded', () => {
            generateMockWorkbookData();
            populateFilterDropdowns();
            applyFilters();
        });

        /**
         * Generate Data modeled on 25082026.xlsx sheets
         */
        function generateMockWorkbookData() {
            const agencies = ['Concentrix', 'Radical Minds', 'Tech Mahindra', 'Aegis', 'In-House CX'];
            const menus = [
                { menu: 'Orders & Delivery', sub: 'Delay in Delivery' },
                { menu: 'Refund & Payment', sub: 'Refund Pending' },
                { menu: 'Account & Profile', sub: 'OTP Issues' },
                { menu: 'Technical Issue', sub: 'App Crash' },
                { menu: 'VIP Escalation', sub: 'Priority Resolution' },
                { menu: 'Product Inquiry', sub: 'Specifications' }
            ];
            const agents = [
                { name: 'Aarav Sharma', agency: 'Concentrix' },
                { name: 'Priya Patel', agency: 'Concentrix' },
                { name: 'Rahul Verma', agency: 'Radical Minds' },
                { name: 'Sneha Gupta', agency: 'Radical Minds' },
                { name: 'Vikram Singh', agency: 'Tech Mahindra' },
                { name: 'Ananya Roy', agency: 'Tech Mahindra' },
                { name: 'Rohan Mehta', agency: 'Aegis' },
                { name: 'Neha Joshi', agency: 'Aegis' },
                { name: 'Karan Malhotra', agency: 'In-House CX' },
                { name: 'Pooja Nair', agency: 'In-House CX' }
            ];

            const startDate = new Date('2026-08-01');
            const records = [];

            for (let i = 0; i < 450; i++) {
                const dateOffset = Math.floor(Math.random() * 25); // 25 days range
                const caseDate = new Date(startDate);
                caseDate.setDate(startDate.getDate() + dateOffset);
                const hour = Math.floor(Math.random() * 12) + 9; // 9 AM to 9 PM
                caseDate.setHours(hour, Math.floor(Math.random() * 60));

                const agentObj = agents[Math.floor(Math.random() * agents.length)];
                const menuObj = menus[Math.floor(Math.random() * menus.length)];
                const isVip = Math.random() < 0.18 ? 'Yes' : 'No';

                // Core measures based on prompt formulas
                const caseCount = 1; // Base case unit
