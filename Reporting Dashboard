            if (activeFilters.agency !== 'ALL') summaryText.push(`Agency: ${activeFilters.agency}`);
            if (activeFilters.menu !== 'ALL') summaryText.push(`Menu: ${activeFilters.menu}`);
            if (activeFilters.vip !== 'ALL') summaryText.push(`VIP: ${activeFilters.vip}`);
            if (activeFilters.agent !== 'ALL') summaryText.push(`Agent: ${activeFilters.agent}`);

