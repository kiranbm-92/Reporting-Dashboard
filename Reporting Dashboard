            activeFilters.agency = document.getElementById('filter-agency').value;
            activeFilters.menu = document.getElementById('filter-menu').value;
            activeFilters.vip = document.getElementById('filter-vip').value;
            activeFilters.agent = document.getElementById('filter-agent').value;

            filteredDataset = rawDataset.filter(item => {
                if (activeFilters.agency !== 'ALL' && item.agency !== activeFilters.agency) return false;
                if (activeFilters.menu !== 'ALL' && item.liveChatMenu !== activeFilters.menu) return false;
                if (activeFilters.vip !== 'ALL' && item.vipUser !== activeFilters.vip) return false;
                if (activeFilters.agent !== 'ALL' && item.agentName !== activeFilters.agent) return false;
                return true;
            });

