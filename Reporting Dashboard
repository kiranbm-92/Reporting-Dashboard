                        label: 'CSAT %',
                        data: csatData,
                        backgroundColor: csatData.map(v => v >= BENCHMARKS.csat ? '#10B981' : '#F59E0B'),
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { backgroundColor: '#1E293B', callbacks: { label: ctx => `CSAT: ${ctx.parsed.y}%` } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#94A3B8', font: { size: 10 } } },
                        y: {
                            min: 0,
                            max: 100,
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: { color: '#94A3B8', font: { size: 10 }, callback: v => v + '%' }
                        }
                    }
                }
            });
        }

        /**
         * Export Executive Summary
         */
        function exportDashboardSummary() {
            const totalCases = filteredDataset.reduce((sum, d) => sum + d.caseCount, 0);
            const totalTickets = filteredDataset.reduce((sum, d) => sum + d.noOfTicketsCreated, 0);
            const ticketPercent = totalCases > 0 ? ((totalTickets / totalCases) * 100).toFixed(2) : '0';
            const avgFrt = totalCases > 0 ? Math.round(filteredDataset.reduce((sum, d) => sum + d.frtSec, 0) / totalCases) : 0;
            const avgFurt = totalCases > 0 ? (filteredDataset.reduce((sum, d) => sum + d.furtMin, 0) / totalCases).toFixed(2) : 0;
            const csatYes = filteredDataset.filter(d => d.csatResolved === 'Yes').length;
            const csatPct = filteredDataset.length > 0 ? ((csatYes / filteredDataset.length) * 100).toFixed(2) : '0';

            const csvContent = "data:text/csv;charset=utf-8," + 
                "Metric,Value,Target / Benchmark,Status\n" +
                `Total Handled Volume,${totalCases},N/A,Active\n` +
                `Ticket Creation %,${ticketPercent}%,<10%,${ticketPercent <= 10 ? 'Met' : 'Breached'}\n` +
                `Average FRT,${avgFrt} sec,<90 sec,${avgFrt <= 90 ? 'Met' : 'Breached'}\n` +
                `Average FuRT,${avgFurt} min,<17.5 min,${avgFurt <= 17.5 ? 'Met' : 'Breached'}\n` +
                `CSAT Score,${csatPct}%,>85%,${csatPct >= 85 ? 'Met' : 'Breached'}\n`;

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `CX_Operations_BI_Summary_${currentGranularity}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
